# Postgres (pgvector/pgvector:pg17)
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/postgres

# LLM provider — at least one key required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Reranker — only needed if switching to cohereReranker in config.ts
COHERE_API_KEY=

# Self-hosted TEI servers (see README for docker run commands)
EMBEDDINGS_BASE_URL=http://localhost:8080
RERANKER_BASE_URL=http://localhost:8081

# 'anthropic' = Claude extracts PDF text (better quality, requires ANTHROPIC_API_KEY)
# 'local'     = unpdf in-process (no API calls, works offline)
UPLOAD_PARSER=anthropic

# Server
PORT=3000
LOG_LEVEL=info

# Trace output path
TRACE_FILE=./logs/traces.jsonl
