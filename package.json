{
  "name": "decade-conviction-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/ingestion/cli.ts",
    "eval": "tsx src/eval/runner.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "franc": "^6.2.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.0",
    "unpdf": "^0.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
